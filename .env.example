# Docker：复制为 .env（和 docker-compose.yml 放在一起）
# systemd：复制为 /etc/picnook.env
# 填好后执行 chmod 600，这个文件里有密码

# 图床对外的网址，上传后返回的链接以它开头
PICNOOK_BASE=https://img.example.com

# 后台登录密码，至少 8 位
PICNOOK_PASSWORD=

# 用于签名登录状态和删除链接，至少 32 个字符，可以用 openssl rand -hex 32 生成
PICNOOK_SECRET=

# API Token，多个用英文逗号分隔。只在首次启动时导入，之后在后台「设置 → API Token」里管理
# 从 EasyImage 迁移时也可以留空，启动后在后台粘贴原来的 config/api_key.php 一键导入
PICNOOK_TOKENS=

# 只读的旧图片目录，例如 EasyImage 早期版本的 /images/ 链接：images=/data/images
PICNOOK_EXTRA_DIRS=

# 单张图片大小上限（MB）的初始值，之后在后台修改
PICNOOK_MAX_MB=10

# 仅 Docker 使用：容器内读写图片的用户和组 ID，要和图片目录的属主一致
PICNOOK_UID=1000
PICNOOK_GID=1000
