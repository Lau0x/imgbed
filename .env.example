# Docker：复制为 .env（和 docker-compose.yml 放在一起）
# systemd：复制为 /etc/easyimage-go.env
# 填好后执行 chmod 600，这个文件里有密码

# 图床对外的网址，上传后返回的链接以它开头
EASYIMAGE_BASE=https://img.example.com

# 后台登录密码，至少 8 位
EASYIMAGE_PASSWORD=

# 用于签名登录状态和删除链接，至少 32 个字符，可以用 openssl rand -hex 32 生成
EASYIMAGE_SECRET=

# API Token，多个用英文逗号分隔。从 EasyImage 迁移时填原来的 token，PicGo 等工具不用改配置
EASYIMAGE_TOKENS=

# 单张图片大小上限（MB）
EASYIMAGE_MAX_MB=10

# 仅 Docker 使用：容器内读写图片的用户和组 ID，要和图片目录的属主一致
EASYIMAGE_UID=1000
EASYIMAGE_GID=1000
